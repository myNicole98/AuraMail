{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AuraMail",
  "version": "../package.json",
  "identifier": "dev.auramail.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "AuraMail",
        "width": 1280,
        "height": 800,
        "minWidth": 480,
        "minHeight": 600,
        "backgroundColor": "#0A0A0A",
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: blob: https:; style-src 'self' 'unsafe-inline'; style-src-elem 'self' 'unsafe-inline'; style-src-attr 'unsafe-inline'; script-src 'self'; connect-src ipc: http://ipc.localhost; frame-src 'self' data: blob:; object-src 'none'; base-uri 'none'; form-action 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "externalBin": ["binaries/auramail-proton-bridge"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../resources/matugen/auramail.toml": "matugen/auramail.toml",
      "../resources/matugen/auramail.json": "matugen/auramail.json",
      "../resources/logo/aura_mail_icon_only.svg": "logo/aura_mail_icon_only.svg"
    }
  }
}
